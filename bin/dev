#!/usr/bin/env bash
# Hybrid local DX (TARGET_ARCHITECTURE.md §1.2): Postgres/Redis/Mailpit run in
# Docker (docker-compose.dev.yml); Rails and Vite run natively via this single
# command, reading Procfile.dev.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v foreman >/dev/null 2>&1; then
  echo "Installing foreman..." >&2
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
