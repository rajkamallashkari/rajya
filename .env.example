# Local / production env template. Copy to `.env` (gitignored).
# Brand token is always `rajya` — see docs/BRAND_IDENTIFIERS.md.

# --- Database (dev Compose) ---
# Host ports are 55432 / 6380, not the Postgres/Redis defaults — see
# docker-compose.dev.yml comments (avoids clashing with a native install).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/rajya_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rajya_development

# --- Redis (dev Compose) ---
REDIS_URL=redis://localhost:6380/0

# Portability (TARGET §1) — proven once Rails boots in 0.2
CABLE_ADAPTER=redis
CACHE_STORE=redis

# --- Mail (local → Mailpit) ---
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@rajya.local

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:5173
# Dev mobile tunnels: also allow https://*.trycloudflare.com (wired in CORS origins)

# --- Google Identity Services (session 2.2 — GIS auth-code only; no redirect) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- WebAuthn (session 2.3). origin must match the SPA; rp_id is the registrable host. ---
# WEBAUTHN_ORIGIN=http://localhost:5173
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Rajya
# WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production hosting (fill when Oracle + Pages exist) ---
# FRONTEND_ORIGIN=https://rajya.pages.dev
# SECRET_KEY_BASE=
# JWT_SECRET=   # signing key; falls back to SECRET_KEY_BASE when unset
# SENDGRID_API_KEY=
# SMTP_FROM=you@example.com
