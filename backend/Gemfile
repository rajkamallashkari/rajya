source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
gem "bcrypt", "~> 3.1.7"

# JWT Bearer tokens (TARGET §1 auth transport). Epoch is checked in Auth::Identity,
# not only at decode time, so Cable and HTTP share one revocation path (F-6).
gem "jwt"

# Auth and API throttles; limits are read from app_settings (TARGET §4.7 / F-2).
gem "rack-attack"

# WebAuthn passkeys (session 2.3). Challenges live in Rails.cache, not cookies.
gem "webauthn"

# Web Push (VAPID) — BR-103. Session 10.2.
gem "web-push"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapters for Rails.cache, Active Job, and Action Cable
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# Redis adapter for Rails.cache / Action Cable — TARGET_ARCHITECTURE §2/§3 portability
# guarantee: Redis when available, Solid Cache/Cable as the zero-infra fallback.
gem "redis", "~> 5.0"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"
gem "blurhash"
# Cloudflare R2 is S3-compatible. Loaded when a bucket's service is S3 (P7.1).
gem "aws-sdk-s3", require: false

# SPA on a different origin than the API (TARGET §1 — Pages + Tunnel).
gem "rack-cors"

# --- Rajya layering (CONVENTIONS.md §2.1) ---

# Serializers — the only place JSON shape is defined (TARGET_ARCHITECTURE §4.2)
gem "alba"

# Authorization — enforced via after_action :verify_authorized (TARGET_ARCHITECTURE §4.4)
gem "pundit"

# OpenAPI 3 generated from annotated request specs (TARGET_ARCHITECTURE §4.5)
gem "rswag-api"

# ActiveRecord type support for the pgvector `vector` column (bot memory — SCHEMA_DESIGN §8)
gem "pgvector"

group :development, :test do
  # Loads ../.env (repo root) — the single env template for local dev (README §Prerequisites)
  gem "dotenv-rails"

  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
  gem "rubocop-rspec", require: false
  gem "rubocop-factory_bot", require: false

  # RSpec — the only test framework (CONVENTIONS.md §2.7: no parallel Minitest suite)
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "rswag-specs"
end

group :test do
  gem "simplecov", require: false
  # N+1 assertions on queries (CONVENTIONS.md §2.7 / TARGET §8).
  gem "n_plus_one_control"
end
