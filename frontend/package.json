{
  "name": "rajya",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --pretty false --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "prove:lint": "node scripts/prove-lint-rules.mjs",
    "prove:coverage-gate": "node scripts/prove-coverage-gate.mjs",
    "generate:api": "openapi-typescript ../backend/swagger/v1/swagger.yaml -o src/shared/lib/api/schema.d.ts"
  },
